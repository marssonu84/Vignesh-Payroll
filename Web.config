<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <!-- Super User Recovery disabled. Use external recovery console only. -->
    <add key="SuperUserRecoveryEnabled" value="false" />
    <!-- V10.24 Two-step sign-in (authenticator app). Set to false to switch the feature off without redeploying. -->
    <add key="TwoStepEnabled" value="true" />
    <!-- Leave blank to automatically play the newest MP3 in Content. Or enter a filename such as school-theme.mp3. -->
    <add key="VisitMusicFile" value="" />
    <!-- Enterprise Hybrid licensing: replace with the provider-issued RSA public key before production use. -->
    <add key="LicenseEnforcementEnabled" value="false" />
    <add key="LicensePublicKeyXml" value="" />
  </appSettings>
  <!-- Database connection moved to external Database.config -->
<system.web>

    <compilation
        debug="false"
        targetFramework="4.8">
      <assemblies>
        <add assembly="System.IO.Compression, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.IO.Compression.FileSystem, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Security, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
    </compilation>

    <httpRuntime
        targetFramework="4.8"
        requestValidationMode="4.5" />

    <pages
        controlRenderingCompatibilityVersion="4.0"
        clientIDMode="AutoID" />

    <globalization
        requestEncoding="utf-8"
        responseEncoding="utf-8"
        fileEncoding="utf-8"
        culture="en-IN"
        uiCulture="en-IN" />

    <!-- Version 10.15: hide raw ASP.NET errors from visitors and show a friendly fallback page. -->
    <customErrors
        mode="Remoteonly"
        defaultRedirect="Site-Under-Maintenance.html"
        redirectMode="ResponseRedirect" />

    <sessionState
        mode="InProc"
        cookieless="UseCookies"
        timeout="30"
        regenerateExpiredSessionId="true" />

    <authentication mode="Forms">
      <forms
          loginUrl="Login.aspx"
          timeout="30"
          slidingExpiration="true"
          cookieless="UseCookies"
          protection="All" />
    </authentication>

    <httpCookies
        httpOnlyCookies="true"
        requireSSL="true"
        sameSite="Lax" />

  </system.web>

  <system.webServer>

    <!-- Version 8.9: public landing page is the site default document. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Default.aspx" />
        <add value="index.html" />
      </files>
    </defaultDocument>


    <!-- Version 10.6: ensure IIS serves MP3 files with the correct MIME type. -->
    <staticContent>
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
    </staticContent>

    <!-- Version 10.15: IIS-level fallback for HTTP 500 errors.
         This also helps when an error occurs before ASP.NET can render its custom error page. -->
    <httpErrors
        errorMode="Custom"
        existingResponse="Replace">
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="500"
             path="/Site-Under-Maintenance.html"
             responseMode="ExecuteURL" />
    </httpErrors>

    <!-- V10.30 speed: compress responses and let browsers keep /Content files for 7 days.
         Changed files carry ?v= version numbers, so updates still show. If the host rejects this block
         (HTTP 500), delete from here to the matching end comment. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <!-- end V10.30 speed block -->

  </system.webServer>

  <location path="Content">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
