<%@ Page Language="C#" AutoEventWireup="true" Inherits="PayrollWebApp.Signup" %>
<!DOCTYPE html><html><head runat="server"><title>Entity Registration - Vighnesh Payroll Systems</title><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<style>*{box-sizing:border-box}body{font-family:Arial,sans-serif;background:#f4f7f6;margin:0;padding:24px;color:#333}.card{max-width:860px;margin:auto;background:#fff;padding:28px;border-radius:12px;box-shadow:0 4px 14px rgba(0,0,0,.12)}h2{text-align:center;margin:0 0 6px}.intro,.notice{text-align:center;color:#667085}.notice{background:#fff8e1;border:1px solid #efd581;padding:11px;border-radius:6px;margin:18px 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field label{display:block;font-weight:600;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;padding:11px;border:1px solid #ccc;border-radius:5px;font-size:15px}.wide{grid-column:1/-1}.section{grid-column:1/-1;font-weight:700;border-bottom:1px solid #e5e7eb;padding:12px 0 5px}.btn{width:100%;padding:12px;border:0;border-radius:5px;background:#087ff5;color:#fff;font-size:16px;font-weight:600;margin-top:18px}.message{display:block;text-align:center;margin-top:12px;color:#c62828}.signin{text-align:center;margin-top:18px}.home-link{display:block;text-align:center;margin-top:10px;color:#667085;font-size:13px;text-decoration:none}.home-link:hover{color:#087ff5}.required{color:#c62828}@media(max-width:650px){.grid{grid-template-columns:1fr}.wide,.section{grid-column:auto}}</style>
<script>function orgChanged(){var v=document.getElementById('ddlOrgType').value;document.getElementById('schoolFields').style.display=v==='School'?'contents':'none';document.getElementById('tradeFields').style.display=v==='Trading Firm'?'contents':'none';}window.addEventListener('load',orgChanged);</script></head><body><form id="signupForm" runat="server"><div class="card"><h2>New Vighnesh Payroll Systems Entity Registration</h2><p class="intro">Register an entity under Vighnesh Payroll Systems and create its first Entity Admin account.</p><div class="notice">Registration will remain <strong>Pending</strong> until approved by the Super User. Additional branches can be created only by the Super User.</div><div class="grid">
<div class="section">Entity Details</div><div class="field"><label>Entity Type <span class="required">*</span></label><asp:DropDownList ID="ddlOrgType" runat="server" ClientIDMode="Static" onchange="orgChanged()"><asp:ListItem Value="">Select</asp:ListItem><asp:ListItem>School</asp:ListItem><asp:ListItem>Trading Firm</asp:ListItem></asp:DropDownList></div><div class="field"><label>Entity Name *</label><asp:TextBox ID="txtOrgName" runat="server" MaxLength="150" /></div>
<div class="field"><label>Contact Person *</label><asp:TextBox ID="txtContact" runat="server" MaxLength="120" /></div><div class="field"><label>Mobile *</label><asp:TextBox ID="txtMobile" runat="server" MaxLength="15" /></div><div class="field"><label>Email *</label><asp:TextBox ID="txtEmail" runat="server" MaxLength="150" /></div><div class="field"><label>PIN Code *</label><asp:TextBox ID="txtPincode" runat="server" MaxLength="6" /></div><div class="field wide"><label>Address *</label><asp:TextBox ID="txtAddress" runat="server" TextMode="MultiLine" Rows="2" MaxLength="250" /></div><div class="field"><label>City *</label><asp:TextBox ID="txtCity" runat="server" MaxLength="80" /></div><div class="field"><label>State *</label><asp:TextBox ID="txtState" runat="server" MaxLength="80" /></div>
<div id="schoolFields" style="display:contents"><div class="section">School Details</div><div class="field"><label>Board Type *</label><asp:DropDownList ID="ddlBoard" runat="server"><asp:ListItem Value="">Select</asp:ListItem><asp:ListItem>CBSE</asp:ListItem><asp:ListItem>ICSE</asp:ListItem><asp:ListItem>State Board</asp:ListItem><asp:ListItem>Cambridge</asp:ListItem><asp:ListItem>IB</asp:ListItem><asp:ListItem>Other</asp:ListItem></asp:DropDownList></div><div class="field"><label>Affiliation Number *</label><asp:TextBox ID="txtAffiliation" runat="server" MaxLength="80" /></div><div class="field"><label>UDISE Number *</label><asp:TextBox ID="txtUdise" runat="server" MaxLength="30" /></div></div>
<div id="tradeFields" style="display:contents"><div class="section">Trading Firm Details</div><div class="field"><label>Business Type *</label><asp:DropDownList ID="ddlBusinessType" runat="server"><asp:ListItem Value="">Select</asp:ListItem><asp:ListItem>Proprietorship</asp:ListItem><asp:ListItem>Partnership</asp:ListItem><asp:ListItem>LLP</asp:ListItem><asp:ListItem>Private Limited</asp:ListItem><asp:ListItem>Public Limited</asp:ListItem><asp:ListItem>Other</asp:ListItem></asp:DropDownList></div><div class="field"><label>GSTIN *</label><asp:TextBox ID="txtGstin" runat="server" MaxLength="15" /></div><div class="field"><label>PAN *</label><asp:TextBox ID="txtPan" runat="server" MaxLength="10" /></div></div>
<div class="section">Entity Admin Account</div><div class="field"><label>Username *</label><asp:TextBox ID="txtUsername" runat="server" MaxLength="50" /></div><div class="field"><label>Password *</label><asp:TextBox ID="txtPassword" runat="server" TextMode="Password" MaxLength="100" /></div><div class="field"><label>Confirm Password *</label><asp:TextBox ID="txtConfirmPassword" runat="server" TextMode="Password" MaxLength="100" /></div></div>
<asp:Button ID="btnSignup" runat="server" Text="Submit Registration for Approval" CssClass="btn" OnClick="btnSignup_Click"/><asp:Label ID="lblMessage" runat="server" CssClass="message"/><p class="signin">Already registered? <a href="Login.aspx">Sign in</a></p><a class="home-link" href="index.html">← Back to Home</a></div></form><script src="Content/visit-music-continuous.js?v=10.6.3"></script></body></html>
